# 复制为 .env 后按实际业务修改。Compose 会自动读取 .env。

# 可视化和 WAD 对外监听地址/端口。
WAD_UI_BIND=127.0.0.1
WAD_UI_PUBLISH_PORT=18089
WAD_PROXY_BIND=127.0.0.1
WAD_PROXY_PUBLISH_PORT=8081

# 任意 HTTP/HTTPS 上游：
# - 宿主机服务：http://host.docker.internal:3000
# - 同 Docker 网络：http://业务容器名:容器端口
# - 远程服务：https://internal.example.com:8443
WAD_PROXY_BACKEND=http://host.docker.internal:3000

# 留空时根据每次请求的 Host 自动识别；固定域名/端口时可显式填写。
WAD_PROXY_PUBLIC_ORIGIN=

# public 保留浏览器 Host；backend 适合要求自身域名 Host 的远程/虚拟主机上游。
WAD_PROXY_HOST_HEADER=public

# 仅在上游页面缺少必要尾斜杠时设置，例如 /pwd,/apply。
WAD_PROXY_DIRECTORY_LINKS=

WAD_PROXY_MODE=monitor
WAD_PROXY_FAIL_POLICY=closed
WAD_PROXY_TIMEOUT=30
WAD_PROXY_MAX_BODY_MB=1

# 可选的真实 WAF 对比端点。对比实验本身必须有正在运行的 Docker 引擎；
# 只有 URL 与版本同时填写，外部产品端点才进入同集评测。
# 端点必须是已部署的真实反向代理，并把允许请求转发到基准回显后端。
# 未配置时界面显示“未配置”，不会生成模拟指标。
WAD_SAFELINE_URL=
WAD_SAFELINE_VERSION=
WAD_OPENAPPSEC_URL=
WAD_OPENAPPSEC_VERSION=
