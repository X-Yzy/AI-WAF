"""The public external corpus must remain reproducible and leakage-resistant."""

import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
EXTERNAL = ROOT / "data" / "external_traffic" / "generated"


def first_record(relative: str) -> dict:
    with (EXTERNAL / relative).open(encoding="utf-8") as handle:
        assert handle.readline().strip() == "["
        return json.loads(handle.readline().rstrip(",\n"))


def test_external_manifest_has_pinned_independent_sources_and_exact_counts():
    manifest = json.loads((EXTERNAL / "manifest.json").read_text(encoding="utf-8"))
    assert manifest["total_records"] == 261_618
    assert manifest["label_counts"] == {"attack": 53_662, "normal": 207_956}
    assert manifest["split_counts"] == {
        "evaluation": 91_662,
        "test": 11_101,
        "train": 147_863,
        "validation": 10_992,
    }
    assert len(manifest["artifacts"]) == 11
    assert all(source.get("sha256") for source in manifest["sources"].values())
    assert manifest["sources"]["mlwaf_payloads"]["commit"]
    assert manifest["sources"]["coreruleset"]["commit"]
    assert manifest["sources"]["web_application_attack_datasets"]["commit"]
    assert manifest["sources"]["payloadbox_csv"]["commit"]
    assert manifest["sources"]["payloadbox_protocol"]["commit"]
    assert manifest["sources"]["payloadbox_smuggling"]["commit"]
    assert manifest["sources"]["piarena_indirect_injection"]["commit"]


def test_external_field_import_removes_old_source_overlap_and_conflicts():
    manifest = json.loads((EXTERNAL / "manifest.json").read_text(encoding="utf-8"))
    report = manifest["source_reports"]["mlwaf_payloads"]
    assert report["records"] == 109_247
    assert report["overlap_with_internal_removed"] == {
        "label_conflict": 15,
        "same_label": 291,
    }
    organized = json.loads(
        (ROOT / "data" / "organized" / "manifest.json").read_text(encoding="utf-8")
    )
    assert organized["content_audit"]["cross_label_content_conflicts"] == 0


def test_external_complete_requests_are_evaluation_only_and_not_field_labels():
    benchmark = first_record("requests/dataset_external_requests_evaluation.json")
    crs = first_record("crs_requests/dataset_external_crs_evaluation.json")
    for record in (benchmark, crs):
        assert record["split"] == "evaluation"
        assert record["raw_request"]
        assert record["exclude_from_payload_model"] is True
        assert record["group_id"] and record["source_version"] and record["label_basis"]


def test_gap_sources_enrich_sparse_types_without_faking_context_free_labels():
    manifest = json.loads((EXTERNAL / "manifest.json").read_text(encoding="utf-8"))
    gap = manifest["source_reports"]["payloadbox_gap_payloads"]
    assert gap["records"] == 205
    assert gap["attack_type_counts"]["csv_formula"] == 106
    assert manifest["source_reports"]["payloadbox_smuggling_requests"]["records"] == 275
    assert manifest["source_reports"]["piarena_indirect_injection"]["records"] == 510

    context_types = {
        "cache_poisoning", "csv_formula", "host_header_poisoning", "hpp",
        "http2_pseudo_header_ambiguity", "protocol_violation",
    }
    gap_records = []
    for split in ("train", "validation", "test"):
        gap_records.extend(json.loads(
            (EXTERNAL / "gap_payloads" / f"dataset_external_gap_payloads_{split}.json").read_text()
        ))
    contextual = [record for record in gap_records if record["attack_type"] in context_types]
    assert contextual and all(record["exclude_from_payload_model"] is True for record in contextual)

    llm = first_record("llm_benchmark/dataset_external_llm_evaluation.json")
    assert llm["attack_type"] == "llm_indirect_rag_injection"
    assert llm["split"] == "evaluation" and llm["exclude_from_payload_model"] is True
    assert llm["conversation"][1]["role"] == "tool"
