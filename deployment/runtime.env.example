# Docker 镜像与构建源
WAD_IMAGE=ai-waf-runtime:latest
PYTHON_IMAGE=python:3.12-slim-bookworm
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
APT_MIRROR=https://mirrors.aliyun.com/debian
APT_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
# HTTP_PROXY=http://proxy.example:7890
# HTTPS_PROXY=http://proxy.example:7890
# NO_PROXY=localhost,127.0.0.1
# 若服务器已预拉取或有可信的国内私有仓库，也可把 PYTHON_IMAGE 改为对应完整镜像名。

# 在线检测 API 与运维控制台；默认只允许本机访问
WAD_API_BIND=127.0.0.1
WAD_API_PORT=8000
CORS_ORIGINS=https://your-console.example.com
WAD_DASHBOARD_USERNAME=admin
# 远程开放控制台前必须设置强随机密码。
WAD_DASHBOARD_PASSWORD=change-this-before-remote-access
# WAD_MODEL_ROOT=/opt/web-attack-detector/models/current

# 前置实时防护代理
WAD_PROXY_BIND=0.0.0.0
WAD_PROXY_PORT=8081
# Linux 服务器默认使用 host network，可直接访问只监听回环地址的原业务。
WAD_PROXY_BACKEND=http://127.0.0.1:3000
# 有公网域名或非标准端口时填写，例如 https://waf.example.cn:8443
# WAD_PROXY_PUBLIC_ORIGIN=https://waf.example.cn
# 仅当旧业务把目录链接错误写成无尾斜杠时填写，例如 /pwd,/apply
# WAD_PROXY_DIRECTORY_LINKS=/pwd,/apply
# 只信任实际位于 WAF 前方的代理网段；默认仅信任本机 Nginx/Apache。
WAD_PROXY_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# 只允许上游已鉴权并安全处理的特定字段；格式：/path:location:name
# WAD_PROXY_FIELD_ALLOWLIST=/admin/about.php:body:about
WAD_PROXY_MODE=monitor
WAD_PROXY_FAIL_POLICY=closed
WAD_PROXY_TIMEOUT=30
WAD_PROXY_MAX_BODY_MB=1
