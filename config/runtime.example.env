# 复制为 .env 后按部署环境调整；本地默认值无需配置。
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAD_DASHBOARD_USERNAME=admin
# WAD_DASHBOARD_PASSWORD=replace-with-a-strong-random-password

# 可选：覆盖默认的 result/data、result/models/current、result/runtime。
# WAD_DATA_ROOT=/absolute/path/to/data
# WAD_MODEL_ROOT=/absolute/path/to/models/current
# WAD_RUNTIME_ROOT=/absolute/path/to/runtime

# 前置反向代理：先 monitor 观察，确认后改为 block。
WAD_PROXY_HOST=0.0.0.0
WAD_PROXY_PORT=8081
WAD_PROXY_BACKEND=http://127.0.0.1:3000
WAD_PROXY_MODE=monitor
WAD_PROXY_FAIL_POLICY=closed
WAD_PROXY_TIMEOUT=30
WAD_PROXY_MAX_BODY_MB=1
# WAD_PROXY_LOG_FILE=/absolute/path/to/proxy_access.jsonl
